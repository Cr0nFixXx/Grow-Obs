# Grow|Observer API – Umgebungskonfiguration
# Kopiere nach .env und passe an.

# Server
PORT=8787
NODE_ENV=development

# PostgreSQL
# Docker: compose overrides this to the internal "db" host; set POSTGRES_PASSWORD below.
# Local without Docker: point at your own server and use the same password there.
DATABASE_URL=postgres://grow:CHANGE_ME@localhost:5432/growobserver
POSTGRES_PASSWORD=CHANGE_ME

# Rate limiting (in-process): TRUST_PROXY=false ignores X-Forwarded-For (set when no reverse proxy is in front).
# TRUST_PROXY=true
# RATE_LIMIT_DISABLED=false

# Generate locally: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=30d

# MinIO / S3 (MinIO-Default, forcePathStyle)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=grow-storage
S3_SECRET_KEY=
S3_BUCKET=growobserver

# CORS – kommagetrennte Origins (PWA-Frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# SameSite des Sitzungs-Cookies: lax (Standard) oder none (nur für iframe-Einbettung, erzwingt Secure+Partitioned)
# COOKIE_SAMESITE=lax
# Nur für Proxys, die Cookie/Authorization verschlucken (Sandbox-Vorschau). In Produktion NICHT setzen.
# ALLOW_HEADER_SESSION=false

# Ersten Betreiber anlegen (ohne Demo-Daten): npm run admin:create -- --email betreiber@example.org
# Demo seed is opt-in, never run automatically or against production.
ALLOW_DEMO_SEED=false
SEED_ADMIN_EMAIL=admin@growobserver.app
SEED_ADMIN_PASSWORD=

# Pin to a reviewed release/digest before deployment.
MINIO_IMAGE=minio/minio:latest
