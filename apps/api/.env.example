# Grow|Observer API – Umgebungskonfiguration
# Kopiere nach .env und passe an.

# Server
PORT=8787
NODE_ENV=development

# PostgreSQL (docker-compose default)
DATABASE_URL=postgres://grow:grow@localhost:5432/growobserver

# Generate locally: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=1h

# MinIO / S3 (MinIO-Default, forcePathStyle)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=grow-storage
S3_SECRET_KEY=
S3_BUCKET=growobserver

# CORS – kommagetrennte Origins (PWA-Frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Docker database password; use URL-safe characters (for example a hex secret).
POSTGRES_PASSWORD=

# Demo seed is opt-in, never run automatically or against production.
ALLOW_DEMO_SEED=false
SEED_ADMIN_EMAIL=admin@growobserver.app
SEED_ADMIN_PASSWORD=

# Pin to a reviewed release/digest before deployment.
MINIO_IMAGE=minio/minio:latest
