# Grow|Obs – Frontend-Konfiguration (Next.js)
#
# Datenbank der eingebetteten API (Standard-Modus, /api).
DATABASE_URL=postgres://user:password@127.0.0.1:5432/app_db

# Secrets → in .env.local (gitignored), NICHT hier. Erzeugen: openssl rand -base64 48
# JWT_SECRET=
# JWT_TTL=30d    # maximale Sitzungsdauer ("Angemeldet bleiben"); Sitzungen sind serverseitig widerrufbar
# Pflicht in Produktion (next start); ohne Secret antwortet die API mit 503.
# ALLOW_EPHEMERAL_JWT_SECRET=true   # nur bewusst für Demos: Sessions enden beim Neustart

# Daten-Modus (Build-Zeit!):
#   nicht gesetzt                    → eingebettete API unter /api (Standard, dauerhaft)
#   NEXT_PUBLIC_API_URL=             → Demo-/Mock-Modus (nur Session)
#   NEXT_PUBLIC_API_URL=https://…    → externe API (Docker-Stack apps/api)
# NEXT_PUBLIC_API_URL=

# Öffentliche URL der Web-App (für OG-/Twitter-Bilder).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vite-Legacy-Build (npm run build:vite) liest stattdessen:
# VITE_API_URL=

# Web-Push (optional, nur eingebettete API / Server): ohne diese drei Werte ist Push aus.
# Schlüsselpaar erzeugen: npm run push:keys --prefix apps/api   (Ausgabe in .env.local übernehmen, nie einchecken)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:betreiber@example.org

# E-Mail-Versand (B-87): SMTP_HOST + SMTP_FROM zusammen setzen. Ab dann ist die E-Mail-Bestätigung Pflicht und der
# Passwort-Reset per Link verfügbar; ohne Werte läuft alles wie bisher. APP_URL = öffentliche Adresse für Links in Mails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Grow|Obs <noreply@example.org>
# APP_URL=https://example.org

# Wochenreport (B-71): Geheimnis für GET /api/cron/weekly-report (Authorization: Bearer …), ≥ 16 Zeichen; ohne Wert ist der Endpunkt aus.
# CRON_SECRET=

# Serverless (Vercel + gepoolte Datenbank, z. B. Supabase Session Pooler Port 5432):
# DB_POOL_MAX=1           # Verbindungen je Instanz (Standard 10); Vercel + Supabase Session-Pooler: 1
# SKIP_MIGRATIONS=true    # Migrationen beim Start überspringen, sobald das Schema steht
# NEXT_PUBLIC_REALTIME=auto|polling   # Build-Zeit; auf Vercel ist der Standard "polling" (kein WebSocket, keine SSE-Dauerverbindung)
